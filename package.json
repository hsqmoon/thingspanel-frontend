  "scripts": {
    "build": "pnpm test && pnpm lint:check && pnpm typecheck && pnpm build:bundle",
    "build:bundle": "cross-env NODE_OPTIONS=--max-old-space-size=4096 VITE_SERVICE_ENV=prod node scripts/build-bundle.mjs",
    "cleanup": "sa cleanup",
    "commit": "sa git-commit",
    "dev": "cross-env VITE_SERVICE_ENV=dev vite",
    "dev:prod": "cross-env VITE_SERVICE_ENV=prod vite",
    "dev:test": "cross-env VITE_SERVICE_ENV=test vite",
    "format": "sa prettier-write",
    "gen-route": "sa gen-route",
    "lint": "eslint . --fix",
    "lint:check": "eslint . --max-warnings=0",
    "logo": "tsx ./scripts/logo.ts",
    "preview": "vite preview",
    "release": "sa release",
    "start": "cross-env VITE_SERVICE_ENV=dev vite",
    "test": "vitest run --config vitest.config.ts",
    "tsx": "tsx",
    "typecheck": "pnpm typecheck:app && pnpm typecheck:packages",
    "typecheck:app": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vue-tsc --noEmit --incremental false",
    "typecheck:packages": "vue-tsc --noEmit -p packages/axios/tsconfig.json && vue-tsc --noEmit -p packages/color-palette/tsconfig.json && vue-tsc --noEmit -p packages/hooks/tsconfig.json && vue-tsc --noEmit -p packages/materials/tsconfig.json && vue-tsc --noEmit -p packages/ofetch/tsconfig.json && vue-tsc --noEmit -p packages/scripts/tsconfig.json && vue-tsc --noEmit -p packages/uno-preset/tsconfig.json && vue-tsc --noEmit -p packages/utils/tsconfig.json",
    "update-pkg": "sa update-pkg",
    "clean-console": "node scripts/remove-console-logs.js"
  },
